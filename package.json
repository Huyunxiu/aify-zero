{
  "name": "aify-zero",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp run db#db:check && vp check && vp run -r test && vp run -r build",
    "dev": "vp run --filter @workspace/server-app --filter web --parallel dev",
    "dev:server": "vp run @workspace/server-app#dev",
    "dev:api": "vp run @workspace/server-app#dev",
    "dev:web": "vp run web#dev",
    "dev:desktop": "vp run desktop#dev",
    "db:baseline": "vp run db#db:baseline",
    "db:check": "vp run db#db:check",
    "db:studio": "vp run db#db:studio",
    "db:generate": "vp run db#db:generate",
    "db:migrate": "vp run db#db:migrate",
    "package:desktop": "vp run desktop#package",
    "package:server": "vp run @workspace/server-app#package",
    "prepare": "vp config"
  },
  "dependencies": {
    "dotenv": "catalog:"
  },
  "devDependencies": {
    "@workspace/config": "workspace:*",
    "ultracite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.5.0"
}
