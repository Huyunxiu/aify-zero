{
  "name": "aify-zero",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp run db#db:check && vp run check:docs && vp check && vp test && vp run -r build",
    "dev": "vp run --filter @workspace/server-app --filter web --parallel dev",
    "dev:server": "vp run @workspace/server-app#dev",
    "dev:api": "vp run @workspace/server-app#dev",
    "dev:web": "vp run web#dev",
    "dev:desktop": "vp run desktop#dev",
    "fake:provider": "tsx packages/agent/src/testing/fake-provider/cli.ts",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "db:baseline": "vp run db#db:baseline",
    "db:check": "vp run db#db:check",
    "db:studio": "vp run db#db:studio",
    "db:generate": "vp run db#db:generate",
    "db:migrate": "vp run db#db:migrate",
    "db:query": "tsx packages/db/src/query.ts",
    "package:desktop": "vp run desktop#package",
    "package:server": "vp run @workspace/server-app#package",
    "check:docs": "tsx scripts/check-doc-pairs.ts",
    "icons": "tsx scripts/generate-icons.ts --tray brand/logo-tray.svg",
    "skills:install": "npx --yes skills@1.9.0 install --frozen-lockfile --agent universal",
    "prepare": "vp config"
  },
  "dependencies": {
    "dotenv": "catalog:"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@orpc/client": "catalog:",
    "@playwright/test": "catalog:",
    "@types/ws": "catalog:",
    "@workspace/agent": "workspace:*",
    "@workspace/agent-client": "workspace:*",
    "@workspace/config": "workspace:*",
    "@workspace/server": "workspace:*",
    "@workspace/shared": "workspace:*",
    "ultracite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.5.0"
}
