{
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "@workspace/agent": ["../../packages/agent/src/index.ts"],
      "@workspace/agent/*": ["../../packages/agent/src/*"],
      "@workspace/agent-client": ["../../packages/agent-client/src/index.ts"],
      "@workspace/agent-client/*": ["../../packages/agent-client/src/*"],
      "@workspace/server/*": ["../../packages/server/src/*"],
      "@workspace/shared/*": ["../../packages/shared/src/*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"]
    },
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
