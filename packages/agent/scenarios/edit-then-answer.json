{
  "name": "edit-then-answer",
  "models": ["fake-fast"],
  "rules": [
    { "when": { "stream": false }, "answer": "Edit one line" },
    {
      "when": { "stream": true },
      "toolCall": {
        "name": "edit-file",
        "args": {
          "path": "notes.md",
          "edits": [
            { "oldText": "second line", "newText": "second line edited" }
          ]
        }
      }
    },
    { "when": { "stream": true }, "answer": "The second line is updated." }
  ]
}
