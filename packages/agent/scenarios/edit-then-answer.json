{
  "name": "edit-then-answer",
  "models": ["fake-fast"],
  "rules": [
    { "when": { "stream": false }, "answer": "改一行" },
    {
      "when": { "stream": true },
      "toolCall": {
        "name": "edit-file",
        "args": {
          "path": "notes.md",
          "edits": [{ "oldText": "第二行", "newText": "第二行已改" }]
        }
      }
    },
    {
      "when": { "stream": true },
      "answer": "已把第二行改好。",
      "slow": { "firstChunkMs": 1500, "chunkMs": 40 }
    }
  ]
}
