{
  "name": "slow-answer",
  "models": ["fake-fast"],
  "rules": [
    { "when": { "stream": false }, "answer": "Fake title" },
    {
      "when": { "stream": true },
      "answer": "Got the first message.",
      "slow": { "firstChunkMs": 3000, "chunkMs": 200 }
    },
    {
      "when": { "stream": true },
      "answer": "Got both messages.",
      "slow": { "firstChunkMs": 800, "chunkMs": 100 }
    },
    { "answer": "One more message." }
  ]
}
