{
  "name": "slow-answer",
  "models": ["fake-fast"],
  "rules": [
    { "when": { "stream": false }, "answer": "假标题" },
    {
      "when": { "stream": true },
      "answer": "第一句收到。",
      "slow": { "firstChunkMs": 3000, "chunkMs": 200 }
    },
    {
      "when": { "stream": true },
      "answer": "两条都收到了。",
      "slow": { "firstChunkMs": 800, "chunkMs": 100 }
    },
    { "answer": "还有一条。" }
  ]
}
