{
  "name": "retry-then-succeed",
  "models": ["fake-fast"],
  "rules": [
    { "when": { "stream": false }, "answer": "假标题" },
    { "when": { "stream": true }, "fail": 429, "retryAfter": 2 },
    { "when": { "stream": true }, "fail": 429, "retryAfter": 2 },
    { "when": { "stream": true }, "answer": "重试成功，这是第 3 次请求。" }
  ]
}
