{
  "name": "retry-then-succeed",
  "models": ["fake-fast"],
  "rules": [
    { "when": { "stream": false }, "answer": "Fake title" },
    { "when": { "stream": true }, "fail": 429, "retryAfter": 2 },
    { "when": { "stream": true }, "fail": 429, "retryAfter": 2 },
    { "when": { "stream": true }, "answer": "Retry succeeded on request 3." }
  ]
}
