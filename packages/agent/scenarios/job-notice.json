{
  "name": "job-notice",
  "models": ["fake-fast"],
  "rules": [
    {
      "when": { "stream": false },
      "answer": "Run a command in the background"
    },
    {
      "when": { "stream": true },
      "toolCall": {
        "name": "bash",
        "args": {
          "command": "sleep 5; echo done",
          "description": "Wait five seconds then print done",
          "run_in_background": true
        }
      }
    },
    {
      "when": { "stream": true },
      "answer": "It is now running in the background."
    },
    { "when": { "stream": true }, "answer": "The background job finished." },
    { "when": { "stream": false }, "answer": "Background job" }
  ]
}
